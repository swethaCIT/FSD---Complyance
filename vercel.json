{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/simulate", "dest": "/api/index.js" },
    { "src": "/scenarios(?:/.*)?", "dest": "/api/index.js" },
    { "src": "/report/generate", "dest": "/api/index.js" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/app.js", "dest": "/frontend/app.js" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}


